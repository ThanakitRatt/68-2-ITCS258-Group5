# ── E2E Test Environment ──────────────────────────────────────────────────────
# Point this at a DEDICATED test database schema so E2E cleanup never
# touches your real data.  Create the schema first:
#   CREATE DATABASE Group5_ICTHotel_Test;
#   GRANT ALL ON Group5_ICTHotel_Test.* TO 'ICTHotelUser'@'%';
# Then run: npx prisma migrate deploy  (or push) against this URL.
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://ICTHotelUser:1234@localhost:3306/Group5_ICTHotel_Test"

MYSQL_DATABASE=Group5_ICTHotel_Test
MYSQL_USER=ICTHotelUser
MYSQL_PASSWORD=1234
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST_PORT=3307

# Redis is MOCKED in the test module — these values are unused at runtime
# but are required so ConfigModule does not warn about missing variables.
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=mysecretkey
JWT_EXPIRATION=3600

# Server
PORT=3001
